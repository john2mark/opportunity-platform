---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Manage Opportunities — Opportunity Platform">
    <section class="py-16">

        <div class="mb-10">
            <p class="text-white/60 text-sm mb-2" id="admin-status">
                Checking access...
            </p>

            <div class="flex items-center justify-between gap-4">
                <div>
                    <h1 class="text-4xl font-bold text-white">
                        Manage Opportunities
                    </h1>

                    <p class="text-white/60 mt-2">
                        Add, review, publish, and manage opportunities.
                    </p>
                </div>

                <a
                    href="/dashboard"
                    class="btn btn-outline text-white"
                >
                    Back to Dashboard
                </a>
            </div>
        </div>


        <!-- Access denied -->

        <div
            id="access-denied"
            class="hidden rounded-xl border border-red-400/20 bg-red-400/10 p-6 text-white"
        >
            <h2 class="text-xl font-semibold mb-2">
                Access denied
            </h2>

            <p class="text-white/70">
                You must be an administrator to access this page.
            </p>

            <a
                href="/dashboard"
                class="inline-block mt-4 btn btn-outline text-white"
            >
                Return to Dashboard
            </a>
        </div>


        <!-- Admin content -->

        <div id="admin-content" class="hidden">


            <!-- Add opportunity form -->

            <div
                id="opportunity-form-container"
                class="hidden mb-10 rounded-xl border border-white/10 bg-white/5 p-6"
            >

                <div class="mb-6">
                    <h2 class="text-2xl font-semibold text-white">
                        Add Opportunity
                    </h2>

                    <p class="text-white/60 mt-1">
                        Create a new opportunity. New opportunities start as drafts.
                    </p>
                </div>


                <form id="opportunity-form">


                    <!-- Basic Information -->

                    <div class="mb-8">

                        <h3 class="text-lg font-semibold text-white mb-4">
                            Basic Information
                        </h3>

                        <div class="grid gap-5 md:grid-cols-2">


                            <div class="md:col-span-2">

                                <label class="block text-white/70 text-sm mb-2">
                                    Opportunity title *
                                </label>

                                <input
                                    type="text"
                                    name="Title"
                                    required
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="e.g. DAAD Development-Related Postgraduate Courses"
                                />

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Institution *
                                </label>

                                <input
                                    type="text"
                                    name="Institution"
                                    required
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="University or organization"
                                />

                            </div>


                            <!-- Opportunity Type -->

                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Opportunity type *
                                </label>

                                <select
                                    name="Opportunity_type"
                                    required
                                    class="w-full rounded-lg bg-slate-900 border border-white/20 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-white/30"
                                >

                                    <option
                                        value=""
                                        class="bg-slate-900 text-white"
                                    >
                                        Select type
                                    </option>

                                    <option
                                        value="Scholarship"
                                        class="bg-slate-900 text-white"
                                    >
                                        Scholarship
                                    </option>

                                    <option
                                        value="Fellowship"
                                        class="bg-slate-900 text-white"
                                    >
                                        Fellowship
                                    </option>

                                    <option
                                        value="Research Position"
                                        class="bg-slate-900 text-white"
                                    >
                                        Research Position
                                    </option>

                                    <option
                                        value="Grant"
                                        class="bg-slate-900 text-white"
                                    >
                                        Grant
                                    </option>

                                    <option
                                        value="Internship"
                                        class="bg-slate-900 text-white"
                                    >
                                        Internship
                                    </option>

                                    <option
                                        value="Postdoctoral Position"
                                        class="bg-slate-900 text-white"
                                    >
                                        Postdoctoral Position
                                    </option>

                                    <option
                                        value="Conference"
                                        class="bg-slate-900 text-white"
                                    >
                                        Conference
                                    </option>

                                    <option
                                        value="Other"
                                        class="bg-slate-900 text-white"
                                    >
                                        Other
                                    </option>

                                </select>

                            </div>


                            <!-- Academic Level -->

                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Academic level
                                </label>

                                <select
                                    name="Academic_level"
                                    class="w-full rounded-lg bg-slate-900 border border-white/20 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-white/30"
                                >

                                    <option
                                        value=""
                                        class="bg-slate-900 text-white"
                                    >
                                        Select level
                                    </option>

                                    <option
                                        value="Undergraduate"
                                        class="bg-slate-900 text-white"
                                    >
                                        Undergraduate
                                    </option>

                                    <option
                                        value="Masters"
                                        class="bg-slate-900 text-white"
                                    >
                                        Masters
                                    </option>

                                    <option
                                        value="PhD"
                                        class="bg-slate-900 text-white"
                                    >
                                        PhD
                                    </option>

                                    <option
                                        value="Postdoctoral"
                                        class="bg-slate-900 text-white"
                                    >
                                        Postdoctoral
                                    </option>

                                    <option
                                        value="Professional"
                                        class="bg-slate-900 text-white"
                                    >
                                        Professional
                                    </option>

                                    <option
                                        value="Any"
                                        class="bg-slate-900 text-white"
                                    >
                                        Any
                                    </option>

                                </select>

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Discipline
                                </label>

                                <input
                                    type="text"
                                    name="Discipline"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="e.g. Law, Chemistry, AI, Engineering"
                                />

                            </div>

                        </div>

                    </div>


                    <!-- Location -->

                    <div class="mb-8">

                        <h3 class="text-lg font-semibold text-white mb-4">
                            Location
                        </h3>

                        <div class="grid gap-5 md:grid-cols-2">

                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Country
                                </label>

                                <input
                                    type="text"
                                    name="Country"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="e.g. Germany"
                                />

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    City
                                </label>

                                <input
                                    type="text"
                                    name="City"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="e.g. Berlin"
                                />

                            </div>

                        </div>

                    </div>


                    <!-- Deadline & Funding -->

                    <div class="mb-8">

                        <h3 class="text-lg font-semibold text-white mb-4">
                            Deadline & Funding
                        </h3>

                        <div class="grid gap-5 md:grid-cols-2">


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Deadline
                                </label>

                                <input
                                    type="date"
                                    name="Deadline"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                />

                            </div>


                            <!-- Funding Type -->

                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Funding type
                                </label>

                                <select
                                    name="Funding_type"
                                    class="w-full rounded-lg bg-slate-900 border border-white/20 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-white/30"
                                >

                                    <option
                                        value=""
                                        class="bg-slate-900 text-white"
                                    >
                                        Select funding
                                    </option>

                                    <option
                                        value="Fully Funded"
                                        class="bg-slate-900 text-white"
                                    >
                                        Fully Funded
                                    </option>

                                    <option
                                        value="Partially Funded"
                                        class="bg-slate-900 text-white"
                                    >
                                        Partially Funded
                                    </option>

                                    <option
                                        value="Tuition Only"
                                        class="bg-slate-900 text-white"
                                    >
                                        Tuition Only
                                    </option>

                                    <option
                                        value="Stipend"
                                        class="bg-slate-900 text-white"
                                    >
                                        Stipend
                                    </option>

                                    <option
                                        value="Self Funded"
                                        class="bg-slate-900 text-white"
                                    >
                                        Self Funded
                                    </option>

                                    <option
                                        value="Varies"
                                        class="bg-slate-900 text-white"
                                    >
                                        Varies
                                    </option>

                                </select>

                            </div>


                            <label class="flex items-center gap-3 text-white/80">
                                <input
                                    type="checkbox"
                                    name="Tuition_covered"
                                    class="h-4 w-4"
                                />
                                Tuition covered
                            </label>


                            <label class="flex items-center gap-3 text-white/80">
                                <input
                                    type="checkbox"
                                    name="Living_expenses_covered"
                                    class="h-4 w-4"
                                />
                                Living expenses covered
                            </label>


                            <label class="flex items-center gap-3 text-white/80">
                                <input
                                    type="checkbox"
                                    name="Travel_covered"
                                    class="h-4 w-4"
                                />
                                Travel covered
                            </label>


                            <label class="flex items-center gap-3 text-white/80">
                                <input
                                    type="checkbox"
                                    name="Accommodation_provided"
                                    class="h-4 w-4"
                                />
                                Accommodation provided
                            </label>

                        </div>

                    </div>


                    <!-- Eligibility -->

                    <div class="mb-8">

                        <h3 class="text-lg font-semibold text-white mb-4">
                            Eligibility & Requirements
                        </h3>

                        <div class="grid gap-5">


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Eligibility summary
                                </label>

                                <textarea
                                    name="Eligibility_summary"
                                    rows="4"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="Who can apply?"
                                ></textarea>

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Nationality requirement
                                </label>

                                <input
                                    type="text"
                                    name="Nationality_requirement"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="e.g. Open to all nationalities"
                                />

                            </div>


                            <div class="grid gap-5 md:grid-cols-2">

                                <label class="flex items-center gap-3 text-white/80">

                                    <input
                                        type="checkbox"
                                        name="Transcript_accepted"
                                        class="h-4 w-4"
                                    />

                                    Transcript accepted at application

                                </label>


                                <label class="flex items-center gap-3 text-white/80">

                                    <input
                                        type="checkbox"
                                        name="Degree_required_at_application"
                                        class="h-4 w-4"
                                    />

                                    Degree required at application

                                </label>

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    English requirement
                                </label>

                                <input
                                    type="text"
                                    name="English_requirement"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="e.g. IELTS 6.5 or equivalent"
                                />

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Documents summary
                                </label>

                                <textarea
                                    name="Documents_summary"
                                    rows="4"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="Required application documents"
                                ></textarea>

                            </div>

                        </div>

                    </div>


                    <!-- Application Information -->

                    <div class="mb-8">

                        <h3 class="text-lg font-semibold text-white mb-4">
                            Application Information
                        </h3>

                        <div class="grid gap-5 md:grid-cols-2">


                            <div class="md:col-span-2">

                                <label class="block text-white/70 text-sm mb-2">
                                    Official URL
                                </label>

                                <input
                                    type="url"
                                    name="Official_url"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="https://..."
                                />

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Contact name
                                </label>

                                <input
                                    type="text"
                                    name="Contact_name"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                />

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Contact email
                                </label>

                                <input
                                    type="email"
                                    name="Contact_email"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                />

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Relocation support
                                </label>

                                <input
                                    type="text"
                                    name="Relocation_support"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                    placeholder="e.g. Available / Not provided"
                                />

                            </div>


                            <div>

                                <label class="block text-white/70 text-sm mb-2">
                                    Visa information
                                </label>

                                <input
                                    type="text"
                                    name="Visa_information"
                                    class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                                />

                            </div>

                        </div>

                    </div>


                    <!-- Description -->

                    <div class="mb-8">

                        <h3 class="text-lg font-semibold text-white mb-4">
                            Description
                        </h3>

                        <textarea
                            name="Description"
                            rows="7"
                            class="w-full rounded-lg bg-white/10 border border-white/10 px-4 py-3 text-white"
                            placeholder="Full opportunity description"
                        ></textarea>

                    </div>


                    <!-- Form message -->

                    <div
                        id="form-message"
                        class="hidden mb-5 rounded-lg p-4 text-sm"
                    ></div>


                    <div class="flex gap-3">

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Create Draft
                        </button>

                        <button
                            type="button"
                            id="cancel-form"
                            class="btn btn-outline text-white"
                        >
                            Cancel
                        </button>

                    </div>

                </form>

            </div>


            <!-- Opportunities -->

            <div class="rounded-xl border border-white/10 bg-white/5 p-6">

                <div class="flex items-center justify-between mb-6">

                    <div>

                        <h2 class="text-2xl font-semibold text-white">
                            Opportunities
                        </h2>

                        <p class="text-white/60 mt-1">
                            Your opportunity database.
                        </p>

                    </div>


                    <button
                        id="add-opportunity"
                        class="btn btn-primary"
                    >
                        + Add Opportunity
                    </button>

                </div>


                <div
                    id="loading"
                    class="text-white/60"
                >
                    Loading opportunities...
                </div>


                <div
                    id="empty-state"
                    class="hidden text-white/60 py-8 text-center"
                >
                    No opportunities have been added yet.
                </div>


                <div
                    id="opportunities-container"
                    class="hidden overflow-x-auto"
                >

                    <table class="w-full text-left">

                        <thead>

                            <tr class="border-b border-white/10">

                                <th class="py-3 pr-4 text-white/60">
                                    Title
                                </th>

                                <th class="py-3 pr-4 text-white/60">
                                    Institution
                                </th>

                                <th class="py-3 pr-4 text-white/60">
                                    Country
                                </th>

                                <th class="py-3 pr-4 text-white/60">
                                    Deadline
                                </th>

                                <th class="py-3 pr-4 text-white/60">
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody id="opportunities-list"></tbody>

                    </table>

                </div>

            </div>

        </div>

    </section>


    <script>

        import { supabase } from '../../lib/supabase';


        const adminStatus =
            document.getElementById('admin-status');

        const accessDenied =
            document.getElementById('access-denied');

        const adminContent =
            document.getElementById('admin-content');

        const opportunityFormContainer =
            document.getElementById(
                'opportunity-form-container'
            );

        const opportunityForm =
            document.getElementById(
                'opportunity-form'
            );

        const addOpportunityButton =
            document.getElementById(
                'add-opportunity'
            );

        const cancelForm =
            document.getElementById(
                'cancel-form'
            );

        const formMessage =
            document.getElementById(
                'form-message'
            );

        const loading =
            document.getElementById('loading');

        const emptyState =
            document.getElementById('empty-state');

        const opportunitiesContainer =
            document.getElementById(
                'opportunities-container'
            );

        const opportunitiesList =
            document.getElementById(
                'opportunities-list'
            );


        async function checkAdminAccess() {

            const {
                data: { user },
                error: userError
            } = await supabase.auth.getUser();


            if (userError || !user) {

                window.location.href = '/login';

                return;

            }


            const {
                data: role,
                error: roleError
            } = await supabase
                .from('user_roles')
                .select('role')
                .eq('user_id', user.id)
                .eq('role', 'admin')
                .maybeSingle();


            if (roleError || !role) {

                if (adminStatus) {

                    adminStatus.textContent =
                        'You do not have administrator access.';

                }

                accessDenied?.classList.remove('hidden');

                return;

            }


            if (adminStatus) {

                adminStatus.textContent =
                    `Signed in as ${user.email}`;

            }


            adminContent?.classList.remove('hidden');

            await loadOpportunities();

        }


        async function loadOpportunities() {


            if (loading) {

                loading.classList.remove('hidden');

            }


            if (emptyState) {

                emptyState.classList.add('hidden');

            }


            if (opportunitiesContainer) {

                opportunitiesContainer.classList.add(
                    'hidden'
                );

            }


            if (opportunitiesList) {

                opportunitiesList.innerHTML = '';

            }


            const {
                data: opportunities,
                error
            } = await supabase
                .from('Opportunities')
                .select(
                    'Id, Title, Institution, Country, Deadline, Status, Created_at'
                )
                .order('Created_at', {
                    ascending: false
                });


            loading?.classList.add('hidden');


            if (error) {

                console.error(error);

                if (emptyState) {

                    emptyState.textContent =
                        'Unable to load opportunities.';

                    emptyState.classList.remove(
                        'hidden'
                    );

                }

                return;

            }


            if (
                !opportunities ||
                opportunities.length === 0
            ) {

                if (emptyState) {

                    emptyState.textContent =
                        'No opportunities have been added yet.';

                    emptyState.classList.remove(
                        'hidden'
                    );

                }

                return;

            }


            opportunitiesContainer?.classList.remove(
                'hidden'
            );


            opportunities.forEach(
                (opportunity) => {

                    const row =
                        document.createElement(
                            'tr'
                        );


                    row.className =
                        'border-b border-white/10';


                    row.innerHTML = `

                        <td class="py-4 pr-4 text-white">
                            ${escapeHtml(
                                opportunity.Title ||
                                'Untitled'
                            )}
                        </td>

                        <td class="py-4 pr-4 text-white/70">
                            ${escapeHtml(
                                opportunity.Institution ||
                                '—'
                            )}
                        </td>

                        <td class="py-4 pr-4 text-white/70">
                            ${escapeHtml(
                                opportunity.Country ||
                                '—'
                            )}
                        </td>

                        <td class="py-4 pr-4 text-white/70">
                            ${opportunity.Deadline || '—'}
                        </td>

                        <td class="py-4 pr-4 text-white/80">
                            ${escapeHtml(
                                opportunity.Status ||
                                '—'
                            )}
                        </td>

                    `;


                    opportunitiesList?.appendChild(
                        row
                    );

                }
            );

        }


        function escapeHtml(value) {

            return String(value)
                .replace(
                    /&/g,
                    '&amp;'
                )
                .replace(
                    /</g,
                    '&lt;'
                )
                .replace(
                    />/g,
                    '&gt;'
                )
                .replace(
                    /"/g,
                    '&quot;'
                )
                .replace(
                    /'/g,
                    '&#039;'
                );

        }


        function showForm() {

            opportunityFormContainer?.classList.remove(
                'hidden'
            );

            opportunityFormContainer?.scrollIntoView({
                behavior: 'smooth'
            });

        }


        function hideForm() {

            opportunityFormContainer?.classList.add(
                'hidden'
            );

            opportunityForm?.reset();

            formMessage?.classList.add(
                'hidden'
            );

        }


        addOpportunityButton?.addEventListener(
            'click',
            showForm
        );


        cancelForm?.addEventListener(
            'click',
            hideForm
        );


        opportunityForm?.addEventListener(
            'submit',
            async (event) => {

                event.preventDefault();


                const formData =
                    new FormData(
                        opportunityForm
                    );


                const opportunity = {

                    Title:
                        formData.get('Title'),

                    Institution:
                        formData.get('Institution'),

                    Opportunity_type:
                        formData.get(
                            'Opportunity_type'
                        ),

                    Academic_level:
                        formData.get(
                            'Academic_level'
                        ) || null,

                    Discipline:
                        formData.get(
                            'Discipline'
                        ) || null,

                    Country:
                        formData.get(
                            'Country'
                        ) || null,

                    City:
                        formData.get(
                            'City'
                        ) || null,

                    Deadline:
                        formData.get(
                            'Deadline'
                        ) || null,

                    Funding_type:
                        formData.get(
                            'Funding_type'
                        ) || null,

                    Tuition_covered:
                        formData.has(
                            'Tuition_covered'
                        ),

                    Living_expenses_covered:
                        formData.has(
                            'Living_expenses_covered'
                        ),

                    Travel_covered:
                        formData.has(
                            'Travel_covered'
                        ),

                    Accommodation_provided:
                        formData.has(
                            'Accommodation_provided'
                        ),

                    Eligibility_summary:
                        formData.get(
                            'Eligibility_summary'
                        ) || null,

                    Nationality_requirement:
                        formData.get(
                            'Nationality_requirement'
                        ) || null,

                    Transcript_accepted:
                        formData.has(
                            'Transcript_accepted'
                        ),

                    Degree_required_at_application:
                        formData.has(
                            'Degree_required_at_application'
                        ),

                    Official_url:
                        formData.get(
                            'Official_url'
                        ) || null,

                    English_requirement:
                        formData.get(
                            'English_requirement'
                        ) || null,

                    Documents_summary:
                        formData.get(
                            'Documents_summary'
                        ) || null,

                    Contact_name:
                        formData.get(
                            'Contact_name'
                        ) || null,

                    Contact_email:
                        formData.get(
                            'Contact_email'
                        ) || null,

                    Relocation_support:
                        formData.get(
                            'Relocation_support'
                        ) || null,

                    Visa_information:
                        formData.get(
                            'Visa_information'
                        ) || null,

                    Description:
                        formData.get(
                            'Description'
                        ) || null,

                    Status:
                        'draft'

                };


                if (formMessage) {

                    formMessage.className =
                        'mb-5 rounded-lg p-4 text-sm bg-white/10 text-white';

                    formMessage.textContent =
                        'Creating opportunity...';

                    formMessage.classList.remove(
                        'hidden'
                    );

                }


                const {
                    error
                } = await supabase
                    .from('Opportunities')
                    .insert(
                        opportunity
                    );


                if (error) {

                    console.error(error);


                    if (formMessage) {

                        formMessage.className =
                            'mb-5 rounded-lg p-4 text-sm bg-red-500/20 text-red-200';

                        formMessage.textContent =
                            error.message;

                    }

                    return;

                }


                if (formMessage) {

                    formMessage.className =
                        'mb-5 rounded-lg p-4 text-sm bg-green-500/20 text-green-200';

                    formMessage.textContent =
                        'Opportunity created successfully as a draft.';

                }


                opportunityForm?.reset();


                await loadOpportunities();


                if (opportunityFormContainer) {

                    opportunityFormContainer.classList.add(
                        'hidden'
                    );

                }

            }
        );


        checkAdminAccess();

    </script>

</Layout>
