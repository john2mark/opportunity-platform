---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const {
    data: {
        user
    }
} = await supabase.auth.getUser();

let applications = [];
let error = null;

if (user) {
    const result = await supabase
        .from('applications')
        .select(`
            id,
            opportunity_id,
            application_cycle_id,
            status,
            applied_at,
            deadline_at_application,
            application_url,
            notes,
            outcome,
            outcome_date,
            created_at,
            Opportunities (
                Id,
                Title,
                Institution,
                Opportunity_type,
                Academic_level,
                Discipline,
                Country,
                City,
                Deadline,
                Funding_type,
                Verification_status,
                Official_url
            ),
            Application_cycles (
                id,
                Cycle_name,
                Application_open_date,
                Application_deadline,
                Status,
                Application_url
            )
        `)
        .eq('user_id', user.id)
        .order('created_at', {
            ascending: false
        });

    applications = result.data ?? [];
    error = result.error;
}
---

<Layout title="Applications — Oppvia">

    <section class="py-12 sm:py-16">

        <!-- HEADER -->
        <div class="mb-10">

            <div class="mb-4">
                <span
                    class="inline-flex items-center gap-2
                    px-4 py-2 rounded-full
                    bg-purple-500/10
                    border border-purple-400/20
                    text-purple-200
                    text-sm font-semibold"
                >
                    📋 Track your applications
                </span>
            </div>

            <h1
                class="text-4xl sm:text-5xl
                font-extrabold
                tracking-tight mb-4"
            >
                Applications
            </h1>

            <p class="text-slate-400 text-lg max-w-2xl">
                Keep track of opportunities you are applying for,
                application deadlines, statuses, and outcomes.
            </p>

        </div>


        <!-- NOT SIGNED IN -->
        {
            !user && (
                <div
                    class="rounded-3xl
                    border border-white/10
                    bg-white/[0.04]
                    backdrop-blur-xl
                    p-8 sm:p-10
                    text-center"
                >

                    <div class="text-5xl mb-5">
                        🔐
                    </div>

                    <h2
                        class="text-2xl
                        font-bold mb-3"
                    >
                        Sign in to manage your applications
                    </h2>

                    <p
                        class="text-slate-400
                        max-w-lg
                        mx-auto mb-6"
                    >
                        Your applications are connected to your
                        account, so you can track them whenever
                        you return to Oppvia.
                    </p>

                    <a
                        href="/login"
                        class="op-btn op-btn-primary"
                        style="text-decoration:none;"
                    >
                        Sign in
                    </a>

                </div>
            )
        }


        <!-- DATABASE ERROR -->
        {
            user && error && (
                <div
                    class="rounded-2xl
                    border border-red-400/20
                    bg-red-500/10
                    p-6"
                >

                    <h2
                        class="font-bold
                        text-red-300 mb-2"
                    >
                        Unable to load applications
                    </h2>

                    <p class="text-red-200/70 text-sm">
                        Please try again later.
                    </p>

                </div>
            )
        }


        <!-- APPLICATIONS -->
        {
            user &&
            !error &&
            applications.length > 0 && (
                <>
                    <div
                        class="flex flex-col
                        sm:flex-row
                        sm:items-end
                        sm:justify-between
                        gap-3 mb-6"
                    >

                        <div>

                            <h2 class="text-xl font-bold">
                                Your applications
                            </h2>

                            <p
                                class="text-sm
                                text-slate-500 mt-1"
                            >
                                {applications.length}
                                {
                                    applications.length === 1
                                        ? ' application'
                                        : ' applications'
                                }
                            </p>

                        </div>

                    </div>


                    <div
                        class="grid grid-cols-1
                        lg:grid-cols-2
                        gap-6"
                    >

                        {
                            applications.map((application) => {

                                const opportunity =
                                    Array.isArray(
                                        application.Opportunities
                                    )
                                        ? application.Opportunities[0]
                                        : application.Opportunities;

                                const cycle =
                                    Array.isArray(
                                        application.Application_cycles
                                    )
                                        ? application.Application_cycles[0]
                                        : application.Application_cycles;

                                if (!opportunity) {
                                    return null;
                                }

                                const deadline =
                                    cycle?.Application_deadline ??
                                    application.deadline_at_application ??
                                    opportunity.Deadline;

                                const applicationUrl =
                                    application.application_url ??
                                    cycle?.Application_url ??
                                    opportunity.Official_url;

                                return (
                                    <article
                                        class="application-card
                                        rounded-2xl
                                        border border-white/10
                                        bg-white/[0.04]
                                        p-6
                                        transition
                                        hover:border-purple-400/30
                                        hover:bg-white/[0.06]"
                                        data-application-id={
                                            application.id
                                        }
                                    >

                                        <!-- HEADER -->
                                        <div
                                            class="flex
                                            items-start
                                            justify-between
                                            gap-4 mb-5"
                                        >

                                            <div class="flex-1">

                                                <p
                                                    class="text-sm
                                                    text-purple-300
                                                    font-semibold mb-2"
                                                >
                                                    {
                                                        opportunity.Opportunity_type ??
                                                        'Opportunity'
                                                    }
                                                </p>

                                                <h3
                                                    class="text-xl
                                                    font-bold
                                                    leading-snug"
                                                >
                                                    {
                                                        opportunity.Title ??
                                                        'Untitled opportunity'
                                                    }
                                                </h3>

                                            </div>


                                            {
                                                opportunity.Verification_status ===
                                                    'verified' && (
                                                    <span
                                                        class="shrink-0
                                                        text-xs
                                                        font-semibold
                                                        px-2.5 py-1
                                                        rounded-full
                                                        bg-emerald-500/10
                                                        border
                                                        border-emerald-400/20
                                                        text-emerald-300"
                                                    >
                                                        ✓ Verified
                                                    </span>
                                                )
                                            }

                                        </div>


                                        <!-- INSTITUTION -->
                                        {
                                            opportunity.Institution && (
                                                <p
                                                    class="text-slate-300
                                                    font-medium mb-3"
                                                >
                                                    {
                                                        opportunity.Institution
                                                    }
                                                </p>
                                            )
                                        }


                                        <!-- LOCATION -->
                                        {
                                            (
                                                opportunity.Country ||
                                                opportunity.City
                                            ) && (
                                                <p
                                                    class="text-slate-500
                                                    text-sm mb-4"
                                                >
                                                    📍
                                                    {
                                                        opportunity.City
                                                            ? `${opportunity.City}, `
                                                            : ''
                                                    }
                                                    {
                                                        opportunity.Country ??
                                                        ''
                                                    }
                                                </p>
                                            )
                                        }


                                        <!-- TAGS -->
                                        <div
                                            class="flex
                                            flex-wrap
                                            gap-2 mb-5"
                                        >

                                            {
                                                opportunity.Academic_level && (
                                                    <span
                                                        class="text-xs
                                                        font-medium
                                                        px-2.5 py-1
                                                        rounded-lg
                                                        bg-blue-500/10
                                                        border
                                                        border-blue-400/20
                                                        text-blue-300"
                                                    >
                                                        {
                                                            opportunity.Academic_level
                                                        }
                                                    </span>
                                                )
                                            }


                                            {
                                                opportunity.Discipline && (
                                                    <span
                                                        class="text-xs
                                                        font-medium
                                                        px-2.5 py-1
                                                        rounded-lg
                                                        bg-purple-500/10
                                                        border
                                                        border-purple-400/20
                                                        text-purple-300"
                                                    >
                                                        {
                                                            opportunity.Discipline
                                                        }
                                                    </span>
                                                )
                                            }


                                            {
                                                opportunity.Funding_type && (
                                                    <span
                                                        class="text-xs
                                                        font-medium
                                                        px-2.5 py-1
                                                        rounded-lg
                                                        bg-cyan-500/10
                                                        border
                                                        border-cyan-400/20
                                                        text-cyan-300"
                                                    >
                                                        {
                                                            opportunity.Funding_type
                                                        }
                                                    </span>
                                                )
                                            }

                                        </div>


                                        <!-- APPLICATION STATUS -->
                                        <div
                                            class="border-t
                                            border-white/10
                                            pt-4 mb-4"
                                        >

                                            <div
                                                class="flex
                                                items-center
                                                justify-between
                                                gap-4"
                                            >

                                                <span
                                                    class="text-sm
                                                    text-slate-500"
                                                >
                                                    Status
                                                </span>

                                                <span
                                                    class="text-sm
                                                    font-semibold
                                                    text-purple-300"
                                                >
                                                    {
                                                        application.status ??
                                                        'Not specified'
                                                    }
                                                </span>

                                            </div>

                                        </div>


                                        <!-- DEADLINE -->
                                        {
                                            deadline && (
                                                <div
                                                    class="flex
                                                    items-center
                                                    justify-between
                                                    gap-4
                                                    border-t
                                                    border-white/10
                                                    pt-4 mb-5"
                                                >

                                                    <span
                                                        class="text-sm
                                                        text-slate-500"
                                                    >
                                                        Deadline
                                                    </span>

                                                    <span
                                                        class="text-sm
                                                        font-semibold
                                                        text-slate-300"
                                                    >
                                                        {
                                                            new Date(
                                                                deadline +
                                                                    'T00:00:00'
                                                            ).toLocaleDateString(
                                                                'en-US',
                                                                {
                                                                    year: 'numeric',
                                                                    month: 'short',
                                                                    day: 'numeric'
                                                                }
                                                            )
                                                        }
                                                    </span>

                                                </div>
                                            )
                                        }


                                        <!-- NOTES -->
                                        {
                                            application.notes && (
                                                <div
                                                    class="mb-5
                                                    rounded-xl
                                                    bg-white/[0.03]
                                                    border
                                                    border-white/10
                                                    p-4"
                                                >

                                                    <p
                                                        class="text-xs
                                                        font-semibold
                                                        text-slate-500
                                                        mb-2"
                                                    >
                                                        Notes
                                                    </p>

                                                    <p
                                                        class="text-sm
                                                        text-slate-300"
                                                    >
                                                        {
                                                            application.notes
                                                        }
                                                    </p>

                                                </div>
                                            )
                                        }


                                        <!-- ACTIONS -->
                                        <div
                                            class="flex
                                            flex-wrap
                                            gap-3"
                                        >

                                            {
                                                applicationUrl && (
                                                    <a
                                                        href={applicationUrl}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="op-btn
                                                        op-btn-primary"
                                                        style="text-decoration:none;"
                                                    >
                                                        Open application →
                                                    </a>
                                                )
                                            }

                                        </div>

                                    </article>
                                );
                            })
                        }

                    </div>
                </>
            )
        }


        <!-- EMPTY STATE -->
        {
            user &&
            !error &&
            applications.length === 0 && (
                <div
                    class="rounded-3xl
                    border border-white/10
                    bg-white/[0.04]
                    backdrop-blur-xl
                    p-8 sm:p-12
                    text-center"
                >

                    <div class="text-5xl mb-5">
                        📋
                    </div>

                    <h2
                        class="text-2xl
                        font-bold mb-3"
                    >
                        No applications yet
                    </h2>

                    <p
                        class="text-slate-400
                        max-w-lg
                        mx-auto mb-6"
                    >
                        When you start tracking an opportunity,
                        it will appear here so you can monitor
                        your application progress.
                    </p>

                    <a
                        href="/opportunities"
                        class="op-btn op-btn-primary"
                        style="text-decoration:none;"
                    >
                        Explore opportunities →
                    </a>

                </div>
            )
        }

    </section>

</Layout>
