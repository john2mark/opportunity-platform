```astro id="3j9wqa"
---
import '../../src/styles/globals.css';
import '../../src/styles/opportunity.css';

import '@fontsource/inter/400.css';
import '@fontsource/inter/800.css';

import interFont400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interFont800 from '@fontsource/inter/files/inter-latin-800-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <title>{title} | Oppvia</title>

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />

        <meta
            name="description"
            content="Discover scholarships, fellowships, research positions, grants, internships, and other opportunities with Oppvia."
        />

        <meta name="generator" content={Astro.generator} />

        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon.svg"
        />

        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={interFont400}
            crossorigin
        />

        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={interFont800}
            crossorigin
        />
    </head>

    <body>
        <div class="op-app">
            <div class="min-h-screen flex flex-col">

                <Header />

                <main class="grow">
                    <slot />
                </main>

                <Footer />

            </div>
        </div>
    </body>
</html>
```
