---
const navItems = [
    { linkText: 'Explore', href: '/' },
    { linkText: 'Opportunities', href: '/opportunities' },
    { linkText: 'Saved', href: '/saved' },
    { linkText: 'Applications', href: '/applications' }
];
---

<header class="op-navbar">
    <div class="op-container">
        <div class="op-nav-inner">

            <a href="/" class="op-brand" aria-label="Oppvia home">
                <span class="op-brand-mark">O</span>
                <span>Oppvia</span>
            </a>

            <nav aria-label="Main navigation">
                <ul
                    style="
                        display: flex;
                        align-items: center;
                        gap: 6px;
                        list-style: none;
                        margin: 0;
                        padding: 0;
                    "
                >
                    {navItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                style="
                                    display: block;
                                    padding: 9px 12px;
                                    border-radius: 10px;
                                    color: #94a3b8;
                                    text-decoration: none;
                                    font-size: 14px;
                                    font-weight: 600;
                                "
                            >
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>

            <div
                style="
                    display: flex;
                    align-items: center;
                    gap: 10px;
                "
            >
                <a
                    href="/ai"
                    class="op-btn op-btn-secondary"
                    style="text-decoration: none;"
                >
                    ✨ AI Assistant
                </a>

                <a
                    href="/login"
                    class="op-btn op-btn-primary"
                    style="text-decoration: none;"
                >
                    Sign in
                </a>
            </div>

        </div>
    </div>
</header>
